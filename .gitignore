# secrets - the Gemini key lives here; .env.example (no key) stays tracked
.env
.env.*
!.env.example

# Vercel CLI link folder (created by `vercel link` / `vercel deploy`; machine-specific)
.vercel/

# the v1 build kept as a local backup, and the review screenshots (regenerated; they are in the review .pptx)
_archive_v1/
_review_shots/

# editor / OS / Office lock files
.vscode/
~$*
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# Python / Node tooling leftovers
__pycache__/
*.pyc
node_modules/

# tool outputs that are not part of the game
_build_report.json
dist/
tools/out/

# raw images from the Codex art brief (imported into public/art by tools/import_art.py)
art-requests/out/

# first-round Codex images that were replaced (kept locally for comparison)
art-requests/round1/
art-requests/round2-real/

# family photos used as references for the characters: never commit or deploy
private/
